# MIME-Typ fuer AVIF nachruesten — Hostinger/LiteSpeed kennt die Endung nicht
# und liefert die Frames sonst als text/plain aus. Das funktioniert nur, weil
# Browser bei <img> am Inhalt schnueffeln; sobald irgendwo
# X-Content-Type-Options: nosniff gesetzt wird, waere jede Scroll-Buehne
# schwarz. (woff2/webp/svg liefert der Server bereits korrekt.)
AddType image/avif .avif

# .js liefert der Server als veraltetes application/x-javascript aus —
# funktioniert, aber pruef-assets.py meldet es. Sauber nachgeruestet:
AddType application/javascript .js

# ============================================================ Go-Live 28.08.2026
# (Der fruehere Staging-noindex-Block fuer view.kortschak.online wurde am
# 03.09.2026 entfernt — das Staging gibt es nicht mehr, einzige Domain ist
# www.schriften-kortschak.at.)

# Kanonisierung: ohne-www -> www, http -> https (greift nur auf der
# Produktionsdomain, Staging bleibt unberuehrt).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^schriften-kortschak\.at$ [NC]
  RewriteRule ^(.*)$ https://www.schriften-kortschak.at/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.schriften-kortschak\.at$ [NC]
  RewriteCond %{HTTPS} !on
  RewriteRule ^(.*)$ https://www.schriften-kortschak.at/$1 [R=301,L]
</IfModule>

# 301-Weiterleitungen der alten WordPress-URLs auf die neue Struktur
# (Rankings/Backlinks erhalten). Anker-Ziele zeigen auf Startseiten-Sektionen.
RedirectMatch 301 ^/kontakt/?$ https://www.schriften-kortschak.at/#kontakt
RedirectMatch 301 ^/unternehmen/?$ https://www.schriften-kortschak.at/#unternehmen
