   SequencePlayer + Scroll-Bühnen
   - Checkpoint-Preload (Frame 1 → letzter → Bisektion), 6 parallele Fetches
   - LRU-Decode-Fenster: decodierte ImageBitmaps sind budgetiert
     (Desktop ≤ ~500 MB, Mobil ≤ ~150 MB — geteilt durch aktive Stapel)
   - Lerp-Glättung, Zeichnen nur bei Frame-Wechsel
   - Beats aus data-beat, Progress→Frame über Knoten-Mapping (PLAN.md §3)
   - Debug: #bmw=0.5 bzw. #arbeiter=0.5 erzwingt den Fortschritt
   ===================================================================== */
var canStages = !reduce && !saveData && 'createImageBitmap' in window && 'fetch' in window;
var isMobile = window.matchMedia('(max-width: 820px)').matches;
/* QA/Abnahme: ?solo=bmw + #bmw=0.7 zeigt NUR diese Bühne im eingefrorenen
   Zustand — für Headless-Screenshots und Look-Abnahmen (M2-Testframes). */
var solo = new URLSearchParams(location.search).get('solo');

function Sequence(base, path, n, ext){
  this.base = base; this.path = path; this.n = n; this.ext = ext;
  this.blobs = new Array(n); this.bitmaps = new Map(); this.decoding = new Set();
}
Sequence.prototype.url = function(i){
  return this.base + this.path + String(i + 1).padStart(4, '0') + '.' + this.ext;
};
Sequence.prototype.fetchFrame = function(i){
  var self = this;
  if(self.blobs[i]) return Promise.resolve();
  return fetch(self.url(i)).then(function(r){ return r.blob(); })
    .then(function(b){ self.blobs[i] = b; })
    .catch(function(){});
};
Sequence.prototype.loadAll = function(onFirst){
  var self = this, order = [0, this.n - 1], seen = {0:1};
  seen[this.n - 1] = 1;
  (function rec(a, b){
    if(b - a < 2) return;
    var m = (a + b) >> 1;
    if(!seen[m]){ seen[m] = 1; order.push(m); }
    rec(a, m); rec(m, b);
  })(0, this.n - 1);
  var k = 0, firstDone = false;
  function pump(){
    if(k >= order.length) return Promise.resolve();
    var i = order[k++];
    return self.fetchFrame(i).then(function(){
      if(!firstDone && self.blobs[0]){ firstDone = true; onFirst && onFirst(); }
      return pump();
    });
  }
  var lanes = []; for(var w = 0; w < 6; w++) lanes.push(pump());
  return Promise.all(lanes);
};
Sequence.prototype.requestBitmap = function(i){
  var self = this;
  if(self.bitmaps.has(i) || self.decoding.has(i) || !self.blobs[i]) return;
  self.decoding.add(i);
  createImageBitmap(self.blobs[i]).then(function(bm){
    self.decoding.delete(i); self.bitmaps.set(i, bm);
  }).catch(function(){ self.decoding.delete(i); });
};
Sequence.prototype.best = function(i){
  var bestK = -1, bd = 1e9;
  this.bitmaps.forEach(function(bm, k){
    var d = Math.abs(k - i);
    if(d < bd){ bd = d; bestK = k; }
  });
  return bestK < 0 ? null : this.bitmaps.get(bestK);
};
Sequence.prototype.prune = function(center, maxKeep){
  if(this.bitmaps.size <= maxKeep) return;
  var keys = [];
  this.bitmaps.forEach(function(bm, k){ keys.push(k); });
  keys.sort(function(a, b){ return Math.abs(b - center) - Math.abs(a - center); });
  while(this.bitmaps.size > maxKeep && keys.length){
    var k = keys.shift(), bm = this.bitmaps.get(k);
    this.bitmaps.delete(k);
    if(bm && bm.close) bm.close();
  }
};

/* Progress→Frame: stückweise linear über Knoten [[p,frame],…] */
function frameForP(knots, p){
  for(var i = 1; i < knots.length; i++){
    if(p <= knots[i][0]){
      var t = (p - knots[i-1][0]) / (knots[i][0] - knots[i-1][0]);
      return knots[i-1][1] + t * (knots[i][1] - knots[i-1][1]);
    }
  }
  return knots[knots.length - 1][1];
}

var stages = [];

function initStage(section){
  var kind = section.dataset.stage;
  var base = section.dataset.base;
  fetch(base + 'manifest.json').then(function(r){ return r.json(); }).then(function(man){
    var rend = isMobile && man.renditions.mobile ? man.renditions.mobile : man.renditions.desktop;
    var rendKey = (isMobile && man.renditions.mobile) ? 'mobile' : 'desktop';
    var step = rend.frameStep || 1;
    var st = {
      el: section, kind: kind, man: man,
      canvas: section.querySelector('.stage__canvas'),
      caps: [].slice.call(section.querySelectorAll('.scap')).map(function(c){
        var b = c.dataset.beat.split(',');
        return { el: c, a: parseFloat(b[0]), b: parseFloat(b[1]) };
      }),
      hint: section.querySelector('.scroll-hint'),
      smooth: 0, lastDrawn: -1, loaded: false, w: rend.width, h: rend.height
    };
    var budget = (isMobile ? 150 : 500) * 1e6;
    var bpf = rend.width * rend.height * 4;

    if(kind === 'bmw'){
      /* Knoten aus PLAN.md §3 — Frames sind Master-Nummern, /step für Rendition */
      st.knots = [[0,1],[0.45,90],[0.55,95],[0.85,135],[1,150]].map(function(k){
        return [k[0], Math.max(1, Math.round(k[1] / step))];
      });
      var frames = man.renditions[rendKey].frames;
      st.seqs = { main: new Sequence(base, rendKey + '/', frames, man.ext) };
      st.shadow = new Sequence(base, man.shadow.path, man.shadow.frames, man.ext);
      st.maxKeep = Math.max(8, Math.floor(budget / bpf));
    } else {
      var pf = Math.round(man.sequences.plain.frames / step);
      var bf = Math.round(man.sequences.brand.frames / step);
      st.knots = [[0,1],[1,bf]];
      st.seqs = {
        plain: new Sequence(base, 'plain/' + rendKey + '/', pf, man.ext),
        brand: new Sequence(base, 'brand/' + rendKey + '/', bf, man.ext)
      };
      /* Wechselfenster in Renditions-Frames → p (linear) */
      st.swap = [ man.events.swapWindow[0] / man.sequences.brand.frames,
                  man.events.swapWindow[1] / man.sequences.brand.frames ];
      st.maxKeep = Math.max(8, Math.floor(budget / bpf / 2));
    }

    section.classList.add('stage--live');
    stages.push(st);

    if(solo === kind){
      [].slice.call(document.body.children).forEach(function(n){
        if(n.tagName !== 'MAIN' && n.tagName !== 'SCRIPT') n.style.display = 'none';
      });
      [].slice.call(document.querySelector('main').children).forEach(function(n){
        if(n !== section) n.style.display = 'none';
      });
      section.style.height = '100vh';
    }

    /* Laden erst in Bühnennähe (±150 % Viewport); im Solo-/Debug-Modus sofort
       (IntersectionObserver feuert unter Headless-Virtual-Time nicht zuverlässig) */
    function startLoad(){
      if(st.loaded) return;
      st.loaded = true;
      Object.keys(st.seqs).forEach(function(k){
        st.seqs[k].loadAll(function(){ section.classList.add('stage--ready'); st.lastDrawn = -1; });
      });
      if(st.shadow) st.shadow.loadAll();
      lio.disconnect();
    }
    var lio = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting) startLoad(); });
    }, { rootMargin: '150% 0px' });
    lio.observe(section);
    if(solo === kind || location.hash.indexOf('#' + kind + '=') === 0) startLoad();
    resizeStage(st);
  }).catch(function(err){
    console.warn('Bühne deaktiviert:', kind, err);
  });
}

function resizeStage(st){
  var s = st.el.querySelector('.stage__sticky');
  var dpr = Math.min(window.devicePixelRatio || 1, 2);
  st.cw = s.clientWidth; st.ch = s.clientHeight;
  st.canvas.width = Math.round(st.cw * dpr);
  st.canvas.height = Math.round(st.ch * dpr);
  st.dpr = dpr; st.lastDrawn = -1;
}

function stageProgress(st){
  var dbg = location.hash.match(new RegExp('#' + st.kind + '=([\\d.]+)'));
  if(dbg) return Math.min(1, Math.max(0, parseFloat(dbg[1])));
  var rect = st.el.getBoundingClientRect();
  var denom = st.el.offsetHeight - window.innerHeight;
  return denom > 0 ? Math.min(1, Math.max(0, -rect.top / denom)) : 0;
}

function drawStage(st){
  var p = st.smooth;
  var ctx = st.canvas.getContext('2d');
  var W = st.canvas.width, H = st.canvas.height;
  var fFloat = frameForP(st.knots, p);
  var fi = Math.round(fFloat) - 1;                     /* 0-basiert */
  var drew = false;                                    /* erst wenn wirklich ein Bitmap
                                                          gezeichnet wurde, gilt der Frame
                                                          als erledigt — sonst nächster Tick */

  /* Ziel-Rechteck: contain, leicht unter der Mitte */
  var maxW = Math.min(W * 0.82, (st.kind === 'bmw' ? 1100 : 480) * st.dpr);
  var maxH = H * (st.kind === 'bmw' ? 0.66 : 0.76);
  var scale = Math.min(maxW / st.w, maxH / st.h);
  var dw = st.w * scale, dh = st.h * scale;
  var dx = (W - dw) / 2, dy = (H - dh) / 2 + H * 0.03;

  ctx.clearRect(0, 0, W, H);

  if(st.kind === 'bmw'){
    /* Schatten (nur heller Modus — im dunklen übernimmt der CSS-Glow) */
    if(st.shadow && !isDark()){
      var si = Math.min(st.shadow.n - 1, Math.round(fFloat * st.shadow.n / st.seqs.main.n) );
      st.shadow.requestBitmap(si);
      var sbm = st.shadow.best(si);
      if(sbm){
        var sw = dw * 0.86, sh = sw * (st.man.shadow.height / st.man.shadow.width);
        ctx.drawImage(sbm, dx + (dw - sw) / 2, dy + dh * 0.80 - sh * 0.45, sw, sh);
      }
      st.shadow.prune(si, 24);
    }
    var seq = st.seqs.main;
    var idx = Math.min(seq.n - 1, Math.max(0, fi));
    for(var d = 0; d <= 10; d++){ seq.requestBitmap(Math.min(seq.n - 1, Math.max(0, idx + d))); seq.requestBitmap(Math.max(0, idx - d)); }
    var bm = seq.best(idx);
    if(bm){ ctx.drawImage(bm, dx, dy, dw, dh); drew = true; }
    seq.prune(idx, st.maxKeep);
  } else {
    var brand = st.seqs.brand, plain = st.seqs.plain;
    var bi = Math.min(brand.n - 1, Math.max(0, fi));
    var pi = Math.min(plain.n - 1, bi);
    var a = st.swap[0], b = st.swap[1];
    for(var d2 = 0; d2 <= 8; d2++){
      brand.requestBitmap(Math.min(brand.n - 1, bi + d2)); brand.requestBitmap(Math.max(0, bi - d2));
      if(p < b + 0.05){ plain.requestBitmap(Math.min(plain.n - 1, pi + d2)); plain.requestBitmap(Math.max(0, pi - d2)); }
    }
    var bbm = brand.best(bi), pbm = plain.best(pi);
    if(p <= a){
      if(pbm){ ctx.drawImage(pbm, dx, dy, dw, dh); drew = true; }
    } else if(p >= b){
      if(bbm){ ctx.drawImage(bbm, dx, dy, dw, dh); drew = true; }
    } else {
      /* Masken-Sweep: EIN Canvas — erst plain, dann Clip + brand (PLAN §3) */
      var t = (p - a) / (b - a);
      var sweepX = dx - dw * 0.05 + (dw * 1.1) * t;
      if(pbm){ ctx.drawImage(pbm, dx, dy, dw, dh); drew = true; }
      ctx.save();
      ctx.beginPath(); ctx.rect(dx - dw * 0.05, dy - 8, sweepX - (dx - dw * 0.05), dh + 16); ctx.clip();
      if(bbm){ ctx.drawImage(bbm, dx, dy, dw, dh); drew = true; }
      ctx.restore();
      /* feine Sweep-Kante */
      var g = ctx.createLinearGradient(sweepX - 14 * st.dpr, 0, sweepX + 2, 0);
      g.addColorStop(0, 'rgba(255,28,32,0)'); g.addColorStop(1, 'rgba(255,28,32,.35)');
      ctx.fillStyle = g;
      ctx.fillRect(sweepX - 14 * st.dpr, dy, 14 * st.dpr + 2, dh);
    }
    brand.prune(bi, st.maxKeep);
    plain.prune(pi, st.maxKeep);
  }

  /* Beats */
  st.caps.forEach(function(c){
    c.el.classList.toggle('is-on', p >= c.a && p <= c.b);
  });
  if(st.hint) st.hint.classList.toggle('is-on', p < 0.04);
  st.el.dataset.p = p.toFixed(3);      /* QA: tatsächlicher (geglätteter) Fortschritt */
  st.lastDrawn = drew ? fFloat : -1;
}

if(canStages){
  document.querySelectorAll('[data-stage]').forEach(initStage);

  var resizeT;
  window.addEventListener('resize', function(){
    clearTimeout(resizeT);
    resizeT = setTimeout(function(){ stages.forEach(resizeStage); }, 120);
  }, { passive: true });

  new MutationObserver(function(){ stages.forEach(function(st){ st.lastDrawn = -1; }); })
    .observe(root, { attributes: true, attributeFilter: ['data-theme'] });
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(){
    stages.forEach(function(st){ st.lastDrawn = -1; });
  });
  window.addEventListener('hashchange', function(){ stages.forEach(function(st){ st.lastDrawn = -1; }); });

  (function tick(){
    stages.forEach(function(st){
      if(!st.loaded) return;
      var target = stageProgress(st);
      st.smooth += (target - st.smooth) * 0.14;
      if(Math.abs(target - st.smooth) < 0.0004) st.smooth = target;
      var f = frameForP(st.knots, st.smooth);
      if(Math.abs(f - st.lastDrawn) > 0.35 || st.lastDrawn < 0) drawStage(st);
    });
    requestAnimationFrame(tick);
  })();
}
})();
</script>

</body>
</html>
